# ========================================================
# GCET PLACEMENT HUB - Local Laptop & Tunnel Configuration
# ========================================================

# Backend Server Port
PORT="3000"

# MySQL Database Configuration (Running on Your Laptop)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="gcet_placement_hub"
DB_USER="root"
DB_PASSWORD="your_mysql_password"

# Allowed Frontend Origins for CORS (comma-separated)
# Include your Google AI Studio Web preview/shared origins and local dev origins
ALLOWED_ORIGINS="https://ais-dev-htjupslzh2ixgjtaq6uldb-22462661599.asia-east1.run.app,https://ais-pre-htjupslzh2ixgjtaq6uldb-22462661599.asia-east1.run.app,https://aistudio.google.com,http://localhost:3000,http://localhost:5173"

# Frontend API Base URL (used by Vite / React via import.meta.env.VITE_API_BASE_URL)
# Localhost laptop run: leave as "/api"
# Google AI Studio Web -> Windows Laptop HTTPS Tunnel: set to "https://your-tunnel.trycloudflare.com/api"
VITE_API_BASE_URL="/api"

# Initial Bootstrap Passwords (Copy .env.example to .env and set your initial values)
# Used exclusively for initial bootstrap seeding & listed account hash verification.
# Never commit .env to version control.
GCET_BOOTSTRAP_PRINCIPAL_PASS="set_principal_initial_password"
GCET_BOOTSTRAP_VC_PASS="set_vice_chairman_initial_password"
GCET_BOOTSTRAP_CHAIRMAN_PASS="set_chairman_initial_password"
GCET_BOOTSTRAP_ADMIN_PASS="set_admin_initial_password"
GCET_BOOTSTRAP_FACULTY_PASS="set_faculty_initial_password"
GCET_BOOTSTRAP_RECRUITER_PASS="set_recruiter_initial_password"
GCET_BOOTSTRAP_OFFICER_PASS="set_officer_initial_password"
GCET_BOOTSTRAP_PLACEMENT_OFFICER_PASS="set_placement_officer_initial_password"
GCET_BOOTSTRAP_STUDENT_SEED_PASS="set_seed_student_initial_password"
