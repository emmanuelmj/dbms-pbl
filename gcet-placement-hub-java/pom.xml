<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.gcet.placementhub</groupId>
    <artifactId>gcet-placement-hub-java</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>GCET PLACEMENT HUB (Java 17 Desktop + MongoDB)</name>
    <description>Smart Placement Cell and Skill Matrix Portal - Geethanjali College of Engineering and Technology. Document-oriented MongoDB edition (Atlas cloud-first with local fallback).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- `release` guarantees Java 17 bytecode + API even when a newer JDK (21/25) is installed on the laptop -->
        <maven.compiler.release>17</maven.compiler.release>
        <flatlaf.version>3.5.4</flatlaf.version>
        <jfreechart.version>1.5.5</jfreechart.version>
        <mongodb.driver.version>5.14.0</mongodb.driver.version>
        <dotenv.version>3.2.0</dotenv.version>
        <bcrypt.version>0.10.2</bcrypt.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <openpdf.version>1.3.43</openpdf.version>
        <exec.mainClass>edu.gcet.placementhub.Main</exec.mainClass>
    </properties>

    <dependencies>
        <!-- FlatLaf Modern Swing Look and Feel (HiDPI / Retina aware on macOS + Windows) -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- JFreeChart for Institutional Placement Analytics -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>${jfreechart.version}</version>
        </dependency>

        <!-- OpenPDF for GCET-Branded Placement PDF Report Exports -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- Official MongoDB Java Driver (synchronous) - MongoDB Atlas + local MongoDB Community -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>${mongodb.driver.version}</version>
        </dependency>

        <!-- dotenv-java: identical `.env` loading on Windows and macOS -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- BCrypt ($2a$/$2b$/$2y$) compatible with existing Node bcryptjs hashes -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <!-- BouncyCastle SCrypt support for backward-compatibility with legacy scrypt$ account hashes -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- `./mvnw exec:java` launches the Swing desktop app directly from sources -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>

            <!-- `./mvnw wrapper:wrapper` regenerates mvnw / mvnw.cmd / .mvn/wrapper if ever needed -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-wrapper-plugin</artifactId>
                <version>3.3.4</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>gcet-placement-hub-java</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
