# ==============================================================================
# GCET Placement Hub - MongoDB Configuration
# Geethanjali College of Engineering & Technology (Hyderabad, Telangana)
# ==============================================================================
# Copy this file to `.env` and fill in your connection details:
#   cp .env.example .env   (macOS / Linux)
#   copy .env.example .env (Windows)
# ==============================================================================

# 1. MongoDB Connection URI (Atlas Cloud-First or Local Fallback)
# For MongoDB Atlas (Recommended for teammate collaboration / presentation):
# MONGO_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/gcet_placement_hub?retryWrites=true&w=majority&appName=GCETPlacementHub"
#
# For Local MongoDB Community Server:
MONGO_URI="mongodb://localhost:27017"

# 2. Database Name (defaults to gcet_placement_hub)
MONGO_DB_NAME="gcet_placement_hub"

# 3. Transparent Local Fallback: if Atlas is unreachable or offline, retry localhost:27017
MONGO_LOCAL_FALLBACK="true"

# 4. Default Demo Accounts Password (used by idempotent seeder)
GCET_DEMO_PASSWORD="Password@123"

# Optional: Custom Bootstrap Passwords for Specific Roles
# GCET_BOOTSTRAP_PRINCIPAL_PASS="Principal@2026"
# GCET_BOOTSTRAP_ADMIN_PASS="Admin@2026"
# GCET_BOOTSTRAP_FACULTY_PASS="Faculty@2026"
# GCET_BOOTSTRAP_RECRUITER_PASS="Recruiter@2026"
# GCET_BOOTSTRAP_OFFICER_PASS="Officer@2026"
# GCET_BOOTSTRAP_STUDENT_SEED_PASS="Student@2026"
